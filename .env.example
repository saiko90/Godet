# Projet Supabase « Godet » (valeurs publiques, utilisables dans le navigateur).
# Sans ces variables, l’app utilise les valeurs par défaut de src/lib/env.ts.
NEXT_PUBLIC_SUPABASE_URL=https://cluavztpktcmsynzvojf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ufgXvTw-4N2CiAOLEx2hRA_US7NSuL3
# Adresse publique du site (liens d’invitation et e-mails de connexion).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails (Resend) : serveur uniquement, jamais NEXT_PUBLIC_. Sans ces deux valeurs, aucun e-mail ne part
# (les invitations restent des liens à copier). Mode d'emploi : docs/notifications.md.
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié chez Resend, par ex. « Godet <rappels@votre-domaine.ch> ».
EMAIL_FROM=
# Facultatif : adresse de réponse par défaut.
EMAIL_REPLY_TO=
